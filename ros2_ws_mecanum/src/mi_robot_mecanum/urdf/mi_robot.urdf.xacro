<?xml version="1.0"?>
<!-- Examen Robótica Móvil — Robot Mecanum + RPLIDAR A3 + Orbbec Astra
     Complete los TODO con los valores de SU variante y de las hojas de datos.
     Validar:  xacro mi_robot.urdf.xacro > /tmp/check.urdf && echo OK -->
<robot name="mi_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Parámetros de la variante ===================== -->
  <!-- TODO (Parte 1): reemplace cada ${TODO} por el valor de su variante -->
  <xacro:property name="rueda_radio" value="${0.07}"/>         <!-- r (m) -->
  <xacro:property name="distancia_ejes" value="${0.42}"/>      <!-- wheelbase (m) -->
  <xacro:property name="separacion_ruedas" value="${0.38}"/>   <!-- track (m) -->
  <xacro:property name="lx" value="${distancia_ejes / 2.0}"/>
  <xacro:property name="ly" value="${separacion_ruedas / 2.0}"/>
  <xacro:property name="rueda_ancho" value="0.04"/>
  <xacro:property name="rueda_masa" value="0.3"/>
  
  <!-- LiDAR (asignado) -->
  <xacro:property name="x_lidar" value="${0}"/>
  <xacro:property name="z_lidar" value="${0.17}"/>
  <xacro:property name="update_rate" value="${8}"/>
  <xacro:property name="samples" value="${2000}"/>
  <xacro:property name="lidar_masa" value="${0.190}"/>

  <!-- Camara (asignado) -->
  <xacro:property name="x_camara" value="${0.2}"/>
  <xacro:property name="z_camara" value="${0.1}"/>
  <xacro:property name="camara_masa" value="${0.31}"/>
  <xacro:property name="clip_near_d" value="${0.6}"/>
  <xacro:property name="clip_far_d" value="${8.0}"/>
  <xacro:property name="clip_near" value="${0.4}"/>
  <xacro:property name="clip_far" value="${2.0}"/>
  <xacro:property name="w_camara" value="${0.165}"/>
  <xacro:property name="h_camara" value="${0.048}"/>
  <xacro:property name="d_camara" value="${0.04}"/>
  <xacro:property name="camara_rate" value="${30}"/> <!-- fps -->
  <xacro:property name="image_width" value="${640}"/>
  <xacro:property name="image_height" value="${480}"/>
  <xacro:property name="horizontal_fov" value="${1.01927}"/> 

  <!-- Chasis (dado) -->
  <xacro:property name="chasis_largo" value="${distancia_ejes + 0.04}"/>
  <xacro:property name="chasis_ancho" value="${separacion_ruedas - rueda_ancho - 0.02}"/>
  <xacro:property name="chasis_alto" value="0.05"/>
  <xacro:property name="chasis_masa" value="3.0"/>

  <!-- ===================== Inercias (dadas) ===================== -->
  <xacro:macro name="inercia_caja" params="m x y z">
    <inertia ixx="${m*(y*y + z*z)/12.0}" ixy="0" ixz="0"
             iyy="${m*(x*x + z*z)/12.0}" iyz="0"
             izz="${m*(x*x + y*y)/12.0}"/>
  </xacro:macro>
  <!-- Cilindro con eje a lo largo de z local -->
  <xacro:macro name="inercia_cilindro" params="m r h">
    <inertia ixx="${m*(3*r*r + h*h)/12.0}" ixy="0" ixz="0"
             iyy="${m*(3*r*r + h*h)/12.0}" iyz="0"
             izz="${m*r*r/2.0}"/>
  </xacro:macro>

  <!-- ===================== Chasis (dado) ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="${chasis_largo} ${chasis_ancho} ${chasis_alto}"/></geometry>
      <material name="azul"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="${chasis_largo} ${chasis_ancho} ${chasis_alto}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="${chasis_masa}"/>
      <xacro:inercia_caja m="${chasis_masa}" x="${chasis_largo}" y="${chasis_ancho}" z="${chasis_alto}"/>
    </inertial>
  </link>

  <!-- ===================== Ruedas (Parte 1) ===================== -->
  <!-- IMPORTANTE: el link debe llamarse rueda_<prefijo> y su <collision> debe ser
       la esfera dada: el launch le añade la fricción que emula los rodillos a 45°. -->
  <xacro:macro name="rueda" params="prefijo x_signo y_signo">
    <link name="rueda_${prefijo}">
      <visual>
        <geometry><cylinder radius="${rueda_radio}" length="${rueda_ancho}"/></geometry>
        <material name="negro"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${rueda_radio}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${rueda_masa}"/>
        <xacro:inercia_cilindro m="${rueda_masa}" r="${rueda_radio}" h="${rueda_ancho}"/>
      </inertial>
      
    </link>
    <joint name="joint_rueda_${prefijo}" type="continuous">
      <axis xyz="0 0 1"/>
      <parent link="base_link"/>
      <child link="rueda_${prefijo}"/>
      <origin xyz="${x_signo*lx} ${y_signo*ly} 0" rpy="-1.5708 0 0"/>
    </joint>
    <!-- TODO: joint "joint_rueda_${prefijo}" tipo continuous entre base_link y
         rueda_${prefijo}, en (x_signo*lx, y_signo*ly, 0). Igual que en el diferencial:
         rpy = -π/2 para que el eje z de la rueda apunte a +y, y eje z. -->
  </xacro:macro>

  <xacro:rueda prefijo="del_izq" x_signo="1" y_signo="1"/>
  <xacro:rueda prefijo="del_der" x_signo="1" y_signo="-1"/>
  <xacro:rueda prefijo="tra_izq" x_signo="-1" y_signo="1"/>
  <xacro:rueda prefijo="tra_der" x_signo="-1" y_signo="-1"/>
  <!-- TODO: instanciar del_der, tra_izq y tra_der -->

  <!-- ===================== RPLIDAR A3 (Parte 2) ===================== -->
  <!-- TODO:link  "lidar_link" (cilindro) con dimensiones y masa de la hoja de datos:
       visual, collision e inertial -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${0.0725/2}" length="0.041"/></geometry>
      <material name="azul"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${0.0725/2}" length="0.041"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${lidar_masa}"/>
      <xacro:inercia_cilindro m="${lidar_masa}" r="${0.0725/2}" h="0.041"/>
    </inertial>
  </link>
  <joint name="joint_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${x_lidar} 0 ${z_lidar}" rpy="0 0 0"/>
  </joint>
  <!-- TODO: joint fijo "joint_lidar" base_link -> lidar_link en la posición de su variante -->
  

  <gazebo reference="lidar_link">
    <sensor name="rplidar_a3" type="gpu_lidar">
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>${update_rate}</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>${samples}</samples>          <!-- muestras por vuelta -->
            <resolution>1</resolution>
            <min_angle>-pi</min_angle>
            <max_angle>pi</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>10</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================== Orbbec Astra (Parte 2) ===================== -->
  <!-- TODO: link "camara_link" (caja) con dimensiones y masa de la hoja de datos -->
  <link name="camara_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${d_camara} ${w_camara} ${h_camara}"/> </geometry>
      <material name="azul"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${d_camara} ${w_camara} ${h_camara}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${camara_masa}"/>
      <xacro:inercia_caja m="${camara_masa}" x="${d_camara}" y="${w_camara}" z="${h_camara}"/>
    </inertial>
  </link>

  <!-- TODO: joint fijo "joint_camara" base_link -> camara_link en la posición de su variante -->
  <joint name="joint_camara" type="fixed">
    <parent link="base_link"/>
    <child link="camara_link"/>
    <origin xyz="${x_camara} 0 ${z_camara}" rpy="0 0 0"/>
  </joint>

  <!-- TODO: link "camara_optica_link" y joint fijo "joint_camara_optica" desde
       camara_link con rpy = (-π/2, 0, -π/2) (REP-103) -->
  <link name="camara_optica_link">
  </link>
  <joint name="joint_camara_optica" type="fixed">
    <parent link="camara_link"/>
    <child link="camara_optica_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>


  <gazebo reference="camara_link">
    <sensor name="astra" type="rgbd_camera">
      <topic>/camara</topic>
      <gz_frame_id>camara_link</gz_frame_id>
      <update_rate>${camara_rate}</update_rate>
      <always_on>1</always_on>
      <camera>
        <horizontal_fov>${horizontal_fov}</horizontal_fov>   <!-- en radianes -->
        <image>
          <width>${image_width}</width>
          <height>${image_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>${clip_near_d}</near>
          <far>${clip_far_d}</far>
        </clip>
        <depth_camera>
          <clip>
            <near>${clip_near_d}</near>
            <far>${clip_far_d}</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
 

  <!-- ===================== Plugins de Gazebo (Parte 1) ===================== -->
  <!-- Motor de una rueda: recibe ω (rad/s) en /vel_rueda_<prefijo>.
       No se usa MecanumDrive: la cinemática la escriben ustedes en el nodo cinematica. -->
  <xacro:macro name="motor" params="prefijo">
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>joint_rueda_${prefijo}</joint_name>
      <use_force_commands>false</use_force_commands>
      <topic>/vel_rueda_${prefijo}</topic>
    </plugin>
  </xacro:macro>

  <gazebo>
    <!-- TODO: motores de del_der, tra_izq y tra_der -->
    <xacro:motor prefijo="del_izq"/>
    <xacro:motor prefijo="del_der"/>
    <xacro:motor prefijo="tra_izq"/>
    <xacro:motor prefijo="tra_der"/>

    <!-- TODO: plugin gz-sim-joint-state-publisher-system (encoders) -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

</robot>
